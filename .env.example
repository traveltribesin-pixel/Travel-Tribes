# ===================================================
# Travel Tribes - Email / SMTP Configuration (Gmail)
# ===================================================

# Sender Gmail Address
SMTP_EMAIL=your-email@gmail.com

# 16-digit Google App Password
SMTP_PASSWORD=your-16-digit-app-password

# Email sender display name
SMTP_FROM_NAME="Travel Tribes"

# Admin email to receive booking and enquiry alerts
ADMIN_NOTIFICATION_EMAIL=hello@traveltribes.in

# SMTP Server Details (Defaults for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ===================================================
# Razorpay Payment Gateway Configuration
# ===================================================

# Razorpay Key ID (Test or Live Key ID, e.g. rzp_test_xxxxxxxxxxxx)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Razorpay Key Secret
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ===================================================
# Google Sheets Sync Webhook (Optional)
# ===================================================
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your-apps-script-id/exec

# ===================================================
# Travel Tribes CRM & Admin Dashboard Credentials
# ===================================================
ADMIN_USERNAME=your-admin-email@traveltribes.in
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SECRET=your-random-32-char-secret-key

# ===================================================
# MongoDB Atlas Database Configuration
# ===================================================
MONGODB_URI=mongodb+srv://<username>:<password>@traveltribes.df8nqqj.mongodb.net/traveltribes?retryWrites=true&w=majority

# ===================================================
# Thrivia CRM Cloud Integration (thrivia.io)
# ===================================================
THRIVIA_KEY=PASTE_YOUR_INGEST_KEY_HERE
THRIVIA_ENDPOINT_URL=https://api.thrivia.io/api/webforms/ingest

# ===================================================
# Google Analytics 4 (GA4) Configuration
# ===================================================
NEXT_PUBLIC_GA_ID=G-0BTW5GX4DG

# ===================================================
# Groq AI Itinerary Parser Configuration
# ===================================================
GROQ_API_KEY=gsk_your_groq_api_key_here

