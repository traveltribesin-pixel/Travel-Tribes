# ===================================================
# Travel Tribes - Email / SMTP Configuration (Gmail)
# ===================================================

# Sender Gmail Address
SMTP_EMAIL=your-email@gmail.com

# 16-digit Google App Password
SMTP_PASSWORD=your-16-digit-app-password

# Email sender display name
SMTP_FROM_NAME="Travel Tribes"

# Admin email to receive booking and enquiry alerts
ADMIN_NOTIFICATION_EMAIL=hello@traveltribes.in

# SMTP Server Details (Defaults for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
